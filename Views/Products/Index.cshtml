@model List<Naval_Midterm.Models.Product>

<h1>Products</h1>

<a asp-action="Create" class="btn btn-primary">Add Product</a>

<div class="row mt-3">

@foreach (var product in Model)
{
    <div class="col-md-4 mb-3">

        <div class="card h-100">

            <div class="card-body">

                <h5 class="card-title">@product.Name</h5>

                <p class="card-text">@product.Description</p>

                <p class="text-muted">@product.Category</p>
                <h5>₱@product.Price</h5>

                <a asp-action="Edit" asp-route-id="@product.Id"
                class="btn btn-warning btn-sm">Edit</a>

                <a asp-controller="Cart" asp-action="Add" asp-route-id="@product.Id"
                class="btn btn-success btn-sm">Add to Cart</a>

                <a asp-action="Delete" asp-route-id="@product.Id"
                class="btn btn-danger btn-sm">Delete</a>

            </div>
        </div>
    </div>
}
</div>